=False\\n    \\\"\\\"\\\"\\n    try:\\n        resp = requests.get(\\n            url,\\n            params=params,\\n            timeout=HTTP_TIMEOUT,\\n            headers={\\n                \\\"User-Agent\\\": \\\"btc-price-streamlit/1.0\\\",\\n                \\\"Accept\\\": \\\"application/json\\\",\\n            },\\n        )\\n    except requests.exceptions.RequestException as exc:\\n        raise PriceFetchError(f\\\"\u7f51\u7edc\u8bf7\u6c42\u5931\u8d25\uff1a{exc}\\\", retryable=True) from exc\\n\\n    if resp.status_code == 429:\\n        raise PriceFetchError(\\\"\u63a5\u53e3\u89e6\u53d1\u901f\u7387\u9650\u5236 (HTTP 429)\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5\\\", retryable=False)\\n    if resp.status_code >= 500:\\n        raise PriceFetchError(f\\\"\u6570\u636e\u6e90\u670d\u52a1\u5f02\u5e38 (HTTP {resp.status_code})\\\", retryable=True)\\n    if resp.status_code >= 400:\\n        raise PriceFetchError(f\\\"\u8bf7\u6c42\u88ab\u62d2\u7edd (HTTP {resp.status_code})\\\", retryable=False)\\n\\n    try:\\n        return resp.json()\\n    except ValueError as exc:\\n        raise PriceFetchError(f\\\"\u54cd\u5e94\u4e0d\u662f\u5408\u6cd5 JSON\uff1a{exc}\\\", retryable=False) from exc\\n\\n\\ndef _get_json_with_retry(url: str, params: dict, retries: int = MAX_RETRIES) -> dict:\\n    \\\"\\\"\\\"\u5e26\u6307\u6570\u9000\u907f\u7684\u91cd\u8bd5\u5305\u88c5\u3002\u4ec5\u5bf9 retryable \u9519\u8bef\u91cd\u8bd5\u3002\\\"\\\"\\\"\\n    last_err: Optional[PriceFetchError] = None\\n    for attempt in range(retries + 1):\\n        try:\\n            return _get_json(url, params)\\n        except PriceFetchError as exc:\\n            if not exc.retryable:\\n                raise                       # \u9650\u6d41 / \u53c2\u6570\u9519\u8bef\uff1a\u76f4\u63a5\u4e0a\u629b\uff0c\u5207\u6362\u5907\u7528\u6e90\\n            last_err = exc\\n            if attempt < retries:\\n                time.sleep(RETRY_BACKOFF * (2 ** attempt))\\n    # \u7406\u8bba\u4e0a\u4e0d\u53ef\u8fbe\uff08\u5faa\u73af\u5185\u5fc5 return \u6216 raise\uff09\uff0c\u4ec5\u4f5c\u7c7b\u578b\u6536\u7a84\\n    raise last_err if last_err else PriceFetchError(\\\"\u672a\u77e5\u9519\u8bef\\\")\\n\\n\\ndef _fetch_from_coingecko() -> PriceSnapshot:\\n    \\\"\\\"\\\"\u4e3b\u6570\u636e\u6e90\uff1aCoinGecko /simple/price\u3002\\n\\n    \u4e00\u6b21\u8bf7\u6c42\u5373\u53ef\u62ff\u5230 \u73b0\u4ef7 + 24h \u6da8\u8dcc\u5e45\u3002CoinGecko \u4e0d\u8fd4\u56de\u6da8\u8dcc\u989d\uff0c\\n    \u6545\u6309 `change = price - price / (1 + pct/100)` \u53cd\u63a8 24 \u5c0f\u65f6\u524d\u7684\u4ef7\u683c\u540e\u8ba1\u7b97\uff0c\\n    \u6570\u5b66\u4e0a\u4e0e\u6da8\u8dcc\u5e45\u4e25\u683c\u4e00\u81f4\u3002\\n    \\\"\\\"\\\"\\n    data = _get_json_with_retry(COINGECKO_URL, COINGECKO_PARAMS)\\n\\n    node = data.get(\\\"bitcoin\\\") if isinstance(data, dict) else None\\n    if not isinstance(node, dict):\\n        raise PriceFetchError(\\\"CoinGecko \u54cd\u5e94\u7f3a\u5c11 `bitcoin` \u5b57\u6bb5\\\")\\n\\n    price = _require_number(node.get(\\\"usd\\\"), \\\"usd\\\")\\n    if price <= 0:\\n        raise PriceFetchError(f\\\"CoinGecko \u8fd4\u56de\u975e\u6cd5\u4ef7\u683c\uff1a{price}\\\")\\n\\n    # \u6da8\u8dcc\u5e45\u7f3a\u5931\u65f6\u89c6\u4e3a\u8be5\u6e90\u4e0d\u53ef\u7528\uff0c\u4ea4\u7531\u5907\u7528\u6e90\u515c\u5e95\uff08\u907f\u514d\u9759\u9ed8\u5c55\u793a 0%\uff09\\n    pct = _require_number(node.get(\\\"usd_24h_change\\\"), \\\"usd_24h_change\\\")\\n\\n    base = 1.0 + pct / 100.0\\n    change = price - (price / base) if base > 1e-9 else 0.0\\n\\n    ts_raw = node.get(\\\"last_updated_at\\\")\\n    source_ts = datetime.fromtimestamp(float(ts_raw)) if _is_finite_number(ts_raw) else None\\n\\n    return PriceSnapshot(\\n        price=price,\\n        change_24h=change,\\n        change_pct_24h=pct,\\n        source=\\\"CoinGecko\\\",\\n        fetched_at=datetime.now(),\\n        source_ts=source_ts,\\n    )\\n\\n\\ndef _fetch_from_binance() -> PriceSnapshot:\\n    \\\"\\\"\\\"\u5907\u7528\u6570\u636e\u6e90\uff1aBinance 24hr ticker\u3002\\n\\n    \u6ce8\u610f\uff1aBTCUSDT \u4ee5 USDT \u8ba1\u4ef7\uff0c\u6b63\u5e38\u60c5\u51b5\u4e0b\u4e0e USD 1:1 \u951a\u5b9a\uff0c\\n    \u6781\u7aef\u8131\u951a\u884c\u60c5\u4e0b\u4f1a\u6709\u5fae\u5c0f\u504f\u5dee\uff0c\u5c5e\u4e8e\u53ef\u63a5\u53d7\u7684\u515c\u5e95\u7cbe\u5ea6\u3002\\n    \\\"\\\"\\\"\\n    data = _get_json_with_retry(BINANCE_URL, BINANCE_PARAMS)\\n    if not isinstance(data, dict):\\n        raise PriceFetchError(\\\"Binance \u54cd\u5e94\u7ed3\u6784\u5f02\u5e38\\\")\\n\\n    price = _require_number(data.get(\\\"lastPrice\\\"), \\\"lastPrice\\\")\\n    if price <= 0:\\n        raise PriceFetchError(f\\\"Binance \u8fd4\u56de\u975e\u6cd5\u4ef7\u683c\uff1a{price}\\\")\\n\\n    change = _require_number(data.get(\\\"priceChange\\\"), \\\"priceChange\\\")\\n    pct = _require_number(data.get(\\\"priceChangePercent\\\"), \\\"priceChangePercent\\\")\\n\\n    ts_raw = data.get(\\\"closeTime\\\")\\n    source_ts = (\\n        datetime.fromtimestamp(float(ts_raw) / 1000.0) if _is_finite_number(ts_raw) else None\\n    )\\n\\n    return PriceSnapshot(\\n        price=price,\\n        change_24h=change,\\n        change_pct_24h=pct,\\n        source=\\\"Binance (BTC/USDT)\\\",\\n        fetched_at=datetime.now(),\\n        source_ts=source_ts,\\n    )\\n\\n\\n# \u6570\u636e\u6e90\u4f18\u5148\u7ea7\u5217\u8868\uff1a\u6309\u987a\u5e8f\u5c1d\u8bd5\uff0c\u547d\u4e2d\u5373\u8fd4\u56de\\n_PROVIDERS: Tuple[Tuple[str, Callable[[], PriceSnapshot]], ...] = (\\n    (\\\"CoinGecko\\\", _fetch_from_coingecko),\\n    (\\\"Binance\\\", _fetch_from_binance),\\n)\\n\\n\\n# =============================================================================\\n# 4. M2 \u2014\u2014 \u7f13\u5b58\u5c42\\n# =============================================================================\\n\\n@st.cache_data(ttl=CACHE_TTL, max_entries=MAX_CACHE_ENTRIES, show_spinner=False)\\ndef load_btc_snapshot(nonce: int = 0) -> PriceSnapshot:\\n    \\\"\\\"\\\"\u6309\u4f18\u5148\u7ea7\u4f9d\u6b21\u5c1d\u8bd5\u5404\u6570\u636e\u6e90\uff0c\u8fd4\u56de\u7b2c\u4e00\u4e2a\u6210\u529f\u7684\u7ed3\u679c\u3002\\n\\n    `nonce` \u8bf4\u660e\uff08\u5173\u952e\u8bbe\u8ba1\uff09\uff1a\\n        \u8be5\u53c2\u6570\u53ea\u4f5c\u4e3a\u7f13\u5b58 key \u7684\u4e00\u90e8\u5206\u5b58\u5728\uff0c\u51fd\u6570\u4f53\u5185\u4e0d\u4f7f\u7528\u3002\\n        \u70b9\u51fb\u300c\ud83d\udd04 \u5237\u65b0\u300d\u65f6\u81ea\u589e nonce \u2192 \u7f13\u5b58 key \u53d8\u5316 \u2192 \u5fc5\u7136\u51fb\u7a7f\u7f13\u5b58\u91cd\u65b0\u8bf7\u6c42\uff0c\\n        \u800c\u666e\u901a rerun\uff08\u5982\u5207\u6362\u63a7\u4ef6\uff09nonce \u4e0d\u53d8 \u2192 \u547d\u4e2d\u7f13\u5b58\uff0c\u4e0d\u4f1a\u88f8\u8c03\u63a5\u53e3\u89e6\u53d1\u9650\u6d41\u3002\\n        \u8fd9\u6bd4 `st.cache_data.clear()` \u66f4\u7cbe\u51c6\uff08\u4e0d\u4f1a\u8bef\u6e05\u5176\u5b83\u7f13\u5b58\uff09\u3002\\n\\n    Raises:\\n        PriceFetchError: \u6240\u6709\u6570\u636e\u6e90\u5747\u5931\u8d25\u65f6\u629b\u51fa\uff0c\u9644\u5e26\u6bcf\u4e2a\u6e90\u7684\u5931\u8d25\u539f\u56e0\u3002\\n    \\\"\\\"\\\"\\n    del nonce  # \u4ec5\u53c2\u4e0e\u7f13\u5b58 key \u8ba1\u7b97\uff0c\u51fd\u6570\u903b\u8f91\u4e0d\u4f7f\u7528\\n\\n    errors: list[str] = []\\n    for name, fetch_fn in _PROVIDERS:\\n        try:\\n            return fetch_fn()\\n        except PriceFetchError as exc:\\n            errors.append(f\\\"{name}\uff1a{exc}\\\")\\n        except Exception as exc:  # noqa: BLE001 \u2014\u2014 \u515c\u5e95\uff0c\u4efb\u4f55\u610f\u5916\u90fd\u4e0d\u5141\u8bb8\u6253\u5d29\u9875\u9762\\n            errors.append(f\\\"{name}\uff1a\u672a\u9884\u671f\u5f02\u5e38 {type(exc).__name__}: {exc}\\\")\\n\\n    raise PriceFetchError(\\\"\u6240\u6709\u6570\u636e\u6e90\u5747\u4e0d\u53ef\u7528 \u2014\u2014 \\\" + \\\"\uff1b\\\".join(errors))\\n\\n\\n# ========================================INFO:autogen_core:Calling message handler for ProductManager_5bbb1907-a4dd-4176-ad5e-8195a7b33495 with messa