def find_primes(n: int) -> list[int]:
    """返回 1 到 n 之间（含 n）的所有素数。

    Args:
        n: 上限，包含 n。

    Returns:
        一个列表，包含 [1, n] 范围内的所有素数；若 n < 2，则返回空列表。
    """
    if n < 2:
        return []

    primes = [2]
    if n == 2:
        return primes

    size = (n - 1) // 2
    is_composite = bytearray(size)
    odd_primes: list[int] = []

    for i in range(3, n + 1, 2):
        idx = (i - 3) // 2
        if not is_composite[idx]:
            odd_primes.append(i)

        for p in odd_primes:
            v = i * p
            if v > n:
                break
            is_composite[(v - 3) // 2] = 1
            if i % p == 0:
                break

    primes.extend(odd_primes)
    return primes
```

